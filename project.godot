; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Survivium"
config/version="0.1"
config/description="Survivium technical prototype: 3D pixel-art world made of levels"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.172549, 0.290196, 0.352941, 1)
boot_splash/image="res://assets/splash.png"
boot_splash/use_filter=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/dpi/allow_hidpi=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=0
limits/opengl/max_lights_per_object=32

[shader_globals]

cut_height={
"type": "float",
"value": 1000.0
}
snow_amount={
"type": "float",
"value": 0.0
}
snow_line={
"type": "float",
"value": 1000.0
}
wetness={
"type": "float",
"value": 0.0
}
foliage_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
grass_tint={
"type": "vec3",
"value": Vector3(1, 1, 1)
}
wind={
"type": "vec2",
"value": Vector2(0.3, 0)
}
cloud_offset={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_cover={
"type": "float",
"value": 0.3
}
player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
cut_ghost={
"type": "float",
"value": 1.0
}
view_height={
"type": "float",
"value": 0.0
}
fog={
"type": "float",
"value": 0.0
}
fog_depth={
"type": "float",
"value": 0.0
}
fog_color={
"type": "vec3",
"value": Vector3(0.8, 0.82, 0.85)
}
fog_drift={
"type": "vec2",
"value": Vector2(0, 0)
}
fog_sea={
"type": "float",
"value": 0.0
}
puddles={
"type": "vec2",
"value": Vector2(0, 0)
}
depth_haze={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
leaf_amount={
"type": "float",
"value": 1.0
}
leaf_litter={
"type": "float",
"value": 0.0
}
night_glow={
"type": "float",
"value": 0.0
}
berry_amount={
"type": "float",
"value": 1.0
}
cloud_noise={
"type": "sampler2D",
"value": ""
}
terrain_atlas={
"type": "sampler2D",
"value": ""
}
heat_map={
"type": "sampler2D",
"value": ""
}
roof_map={
"type": "sampler2D",
"value": ""
}
roof_map_soft={
"type": "sampler2D",
"value": ""
}
wrap_size={
"type": "vec2",
"value": Vector2(256, 256)
}
view_up={
"type": "vec2",
"value": Vector2(0, -1)
}
view_squash={
"type": "float",
"value": 1.0
}
view_slope={
"type": "float",
"value": 1.0
}
sun_view={
"type": "vec3",
"value": Vector3(0, 0, 1)
}
light_side={
"type": "vec2",
"value": Vector2(0, 1)
}
