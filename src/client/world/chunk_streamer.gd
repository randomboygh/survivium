extends RefCounted
## The chunks of the world on screen and the level cut. The world is generated by the
## server's session around the players (Session.make_chunks, before the client's
## frame) and meshed here a chunk at a time around the player: the chunks near the
## spawn before play, then the chunks within LOAD_RANGE of the player, nearest first,
## a column of cells at a time within a frame budget, each once the session has made
## it (WorldGen.needed). Edited chunks are rebuilt first; chunks that fall beyond
## UNLOAD_RANGE lose their meshes (the session forgets their cells beyond
## Session.DROP). The caps over the cut are kept on the chunks around the player, and
## the cut itself moves: automatic under a roof or in a cave, manual with the level
## buttons. `game` is the Main node that owns the scene.

const ChunkMesher := preload("res://src/client/world/chunk_mesher.gd")
const Foliage := preload("res://src/client/world/foliage.gd")
const PixelView := preload("res://src/client/view/pixel_view.gd")
const SolidMap := preload("res://src/client/world/solid_map.gd")
const Mat := preload("res://src/shared/content/materials.gd")
const WorldData := preload("res://src/shared/world/world_data.gd")
const WorldGen := preload("res://src/shared/world/world_gen.gd")
const Session := preload("res://src/shared/game/session.gd")
const EdgeHaze := preload("res://src/client/world/edge_haze.gd")

## Chunk size in cells.
const CHUNK := WorldData.CHUNK
const CELL := WorldData.CELL
## World units the shaders may move what a chunk draws past its mesh (leaves and grass
## swaying, ice raised): the margin of its culling box (see PixelView.sheared_box).
const SWAY := 1.0
## Play starts when the chunks within NEAR_CHUNKS of the spawn are built.
const NEAR_CHUNKS := 3
## Chunks this close to the player (in chunks) are built with the edit budget, so the
## ground the player walks onto is there before the far chunks (the session makes them
## with its near budget too).
const URGENT_CHUNKS := Session.NEAR
## Chunks within this many chunks of the player are built: the session's zone, which it
## makes; beyond UNLOAD_RANGE their meshes are freed.
const LOAD_RANGE := Session.ZONE
const UNLOAD_RANGE := 8
## While the game is paused (its menu open) the chunks are built this far, as the
## session makes them then, still within UNLOAD_RANGE.
const PAUSE_RANGE := Session.PAUSE_ZONE
## Chunks this far (in chunks) from the player's get a cap over the level cut; farther
## ones are off the screen on any device and are built when they come near.
const CAP_RANGE := 5
## How much of a frame may go to building caps, to remeshing edited chunks and to
## generating and building the far chunks of the map, in microseconds; a chunk is
## built a column of cells at a time (ChunkMesher.step, Foliage.step, WorldGen.step),
## so what does not fit waits for the next frame. The session's generation (before the
## frame, see gen_budgets) comes out of the same budget: run_jobs takes what it spent.
const CAP_BUDGET_US := 3000
## How many levels of caps a chunk keeps built (see cap_cache).
const CAP_KEPT := 4
const EDIT_BUDGET_US := 9000
## Microseconds a frame for building the near chunks behind the main menu (load_steps):
## the menu keeps moving while the world is made, a little slower than at once. Where
## the menu alone takes longer a frame (a slow screen), loading gets as long as it took,
## up to LOAD_MAX_US, so the world is still built in about twice the time at most.
const LOAD_BUDGET_US := 14000
const LOAD_MAX_US := 100000
const STREAM_BUDGET_US := 3000
## While a chunk on screen has no ground yet (the player outran the building: running,
## a fast playtest speed, a boat down a river), building it and making it may take this
## much of a frame: the frame rate drops a while, and less of the world is missing.
const LAG_BUDGET_US := 16000
## Seconds of the player's way ahead the chunks are built for: the chunks on the screen
## seen from there and from the player come first (see _screen_score).
const LOOK_AHEAD := 1.5
## How far ahead (world units) the look may go at most: three chunks.
const LEAD_MOST := 24.0
## Chunks this near the player's keep what their meshes and plants were built from (see
## `kept`), so an edit there rebuilds only the columns around it (ChunkMesher.patch):
## every chunk streamed in, so the first tree felled at a new place does not wait for
## whole chunks (a few seconds on a phone). About 0.25 MB a chunk, some 30 MB in all.
const KEEP_CHUNKS := LOAD_RANGE
## Chunks this near the player's that keep nothing (built while it was far, in the ring
## beyond KEEP_CHUNKS that stays drawn) are built again in idle frames to keep it.
const REFILL_CHUNKS := 1
## Chunks whose meshes are freed in one frame at most.
const UNLOADS_PER_FRAME := 2
## Kept jobs of chunks now far let go of in one frame at most: after a long way (a
## teleport, a fall into a cave) all of them are far, and freeing 121 at once took 5 ms
## and more outside the budgets (frame_test, 2026-11-08).
const FORGETS_PER_FRAME := 4
## How many levels above and below the player's the level buttons may look; from deep
## in a pit, up to the surface over it (see view_range).
const VIEW_REACH := 4
## Cells behind the player searched for earth rising over the head (see _rises_behind).
const RISE_REACH := 6
## Levels above the feet searched for earth that hides the player from the camera.
const HIDE_REACH := 16
const COMPASS: Array[Vector2i] = [Vector2i(0, -1), Vector2i(1, -1), Vector2i(1, 0), Vector2i(1, 1),
	Vector2i(0, 1), Vector2i(-1, 1), Vector2i(-1, 0), Vector2i(-1, -1)]
## The parts of a chunk's meshes, in the order of chunk_nodes' arrays.
const PARTS := ["solid", "water", "grass", "clumps", "shadows", "bushes", "drifts"]

var game
var world: WorldData
var gen: WorldGen
var chunk_nodes := {}
## Chunks within LOAD_RANGE still to build, and the chunk they were listed around
## (the player's, see focus).
var pending_chunks: Array[Vector2i] = []
var load_home := Vector2i(-1000000, 0)
var unload_queue: Array[Vector2i] = []
## The near chunks are built by run_jobs a step at a time within LOAD_BUDGET_US
## (behind the main menu) instead of whole by build_near (the loading screen, tools).
var load_steps := false
var near_pending := 0
## When run_jobs ended last frame, and the budget for loading this frame (see LOAD_MAX_US).
var _jobs_end := 0
var load_budget := LOAD_BUDGET_US
## The game is paused: run_jobs builds within PAUSE_RANGE on the loading budget.
var paused := false
var load_reach := LOAD_RANGE
var near_total := 0
## While the character lies dead, the respawn point the death screen offers first
## (world units), else Vector3.INF: the chunks are built around it instead of around
## the body, so coming back there lands in a world already made, and none are freed
## meanwhile (the place of death stays behind the screen). See set_focus.
var focus := Vector3.INF
## One cap over the cut per chunk (see update_caps): nodes, the level each was built
## for, and the chunks within CAP_RANGE of the player, nearest first.
var cap_nodes := {}
var cap_levels := {}
## The caps built lately, by chunk and then by level (at most CAP_KEPT levels a chunk):
## a cut that comes back to a level (the player stepping in and out behind a big
## object) shows its caps at once instead of building them again chunk by chunk, which
## left holes flickering over the cut. A chunk's go when it is meshed again or freed.
var cap_cache := {}
## The level every chunk in range has its cap built for, -1 while some are still to
## build: update_caps does nothing more until a chunk or the cut changes.
var _caps_ready := -1
var cap_order: Array[Vector2i] = []
var cap_home := Vector2i(-1000000, 0)
## Chunks that changed since they were last meshed, and the chunk being built now
## (see run_jobs): its key, whether it is an edit, its budget, and its mesh and plant
## jobs (none while the session is still making the chunk).
var dirty_chunks := {}
## The chunks among them whose own cells changed (the column of a dug cell, of a felled
## tree), not only a neighbour's: they go before the others, and things fallen near
## them wait for them to be drawn (Props.show_drops).
var edited := {}
## The columns of each of them to build again (Rect2i in cells; the whole chunk for a
## change of how it looks with no cell changed).
var dirty_rects := {}
## The finished mesh and plant jobs of the chunks within KEEP_CHUNKS of the player
## ([ChunkMesher.Job, Foliage.Job] by key), which an edit patches; the chunks within
## REFILL_CHUNKS with none, in the order to build them again, for idle frames;
## and the player's chunk they were listed around.
var kept := {}
var keep_queue: Array[Vector2i] = []
## The kept chunks found far when the player came to another chunk, to let go of a few
## a frame (FORGETS_PER_FRAME).
var forget_queue: Array[Vector2i] = []
var kept_home := Vector2i(-1000000, 0)
## The kept jobs the job being built patches ([] for a whole chunk), and whether it builds
## a chunk only to keep its jobs (it gives way to edits).
var job_old := []
var job_keep := false
## How many edits were built by patching kept jobs (tests).
var patches := 0
## A chunk being streamed (or built to keep its jobs) set aside for an edit, to go on
## where it stopped once the edits are built: [key, mesh job, plant job, part, meshes,
## plant parts, keep, budget], [] for none. Before 2026-11-08 the edit waited for it:
## a far chunk at the stream budget kept a felled tree standing for seconds on a phone.
var stashed := []
var job_key := Vector2i.ZERO
var job_edit := false
var job_budget := 0
var has_target := false
var job_mesh: ChunkMesher.Job
var job_plants: Foliage.Job
## Once the columns of the chunk are built: the part being finished (see run_jobs; -1
## while the columns are still being built) and what the parts made so far.
var job_part := -1
## The chunk being built is new on screen: its ground and water are shown as soon as
## they are built, and its plants (Foliage) are built after (job_part -2, see
## _finish_part). A chunk of `bare` has its ground and waits for its plants.
var job_ground := false
var bare := {}
## Where the player is going: world units (x, z) ahead of it, LOOK_AHEAD seconds of its
## way, smoothed (see _track_motion).
var lead := Vector2.ZERO
var _last_at := Vector2.INF
var _last_ms := 0
## A chunk on the screen has no ground yet (see _check_lag): building gets LAG_BUDGET_US.
var lagging := false
## The haze over the edge of what is built (the «Дымка на краю» setting), null when off.
var haze: EdgeHaze
var haze_on := false
var job_meshes := []
var job_plant_parts := {}
## Chunks just made whose columns the roof map (part 0) and the minimap (part 1)
## still have to take, one a frame: Vector3i(key.x, key.y, part).
var paint_queue: Array[Vector3i] = []
## True once every chunk within LOAD_RANGE of the player is built.
var map_done := false
## Time spent in the budgeted loops (chunk steps, caps, and the session's generation
## given to run_jobs), for tests/frame_test.gd to tell it from what a frame does
## outside a budget.
var budget_us := 0
## Time spent building, for the log.
var mesh_us := 0
## Time spent on each kind of work since take_work last read it, for the loading
## screens (see Main.loading_phase): "meshes", with the session's kinds.
var work_us := {}
## Painting into the roof map and the minimap goes at once while a chunk is built whole
## (see build_chunk), else one a frame (see paint_queue).
var _whole := false

var cut_level := -1
## The solid cells round the player, for the rock the view in layers fills in.
var solid := SolidMap.new()
var _depth_steps := Vector4.ZERO
var manual_level := -1
## The column whose surface was found last, and that surface (see view_range).
var _surface_at := Vector3i(1 << 30, 0, 0)
var _surface := 0
## The cut the player's position asks for; the view follows it at once.
var cut_target := -1
## The level the player last stood on: a jump does not move the cut.
var ground_level := 0
var indoor := false
## The view in layers is on: where the automatic cut
## would cut the view, nothing is cut and the shaders dither away what stands in front
## of the player and over their head instead (CaveLayers), from the cell layer_base.
var layers_on := false
var layer_base := Vector3i.ZERO
## Where the earth that hides the player was last worked out: Vector3i(x, level, z).
var hidden_at := Vector3i(0, -1000, 0)
## The lowest level of earth between the camera and the player's body, -1 for none
## (see _hiding_level); worked out where the player stands.
var hidden_by := -1
## Earth hides the player, but nothing rises behind them: a hill, left whole.
var hill := false
## The earth hidden_by found stands as a sheer wall (see _sheer_below).
var _hide_steep := false
## The view hidden_by was worked out for (up and slope, see _hiding_level).
var _hidden_view := Vector3.ZERO


func _init(g) -> void:
	game = g


## Takes the generator (and its world) and counts the near chunks that must be
## built before play.
func prepare(g: WorldGen) -> void:
	gen = g
	world = g.world
	# Under the sea's surface the light of the sun and the sky fades (sea_bright).
	RenderingServer.global_shader_parameter_set("sea_top", (world.sea_level + 1) * CELL)
	gen.made.connect(_on_generated)
	ground_level = game.player.level()
	_list_pending()
	var home := _player_chunk()
	for key in pending_chunks:
		if _is_near(key, home):
			near_total += 1
	near_pending = near_total


## Builds the near chunks for up to `ms` milliseconds (the loading screen); true once
## they are all built.
func build_near(ms: int) -> bool:
	var t0 := Time.get_ticks_msec()
	var home := _player_chunk()
	while near_pending > 0 and Time.get_ticks_msec() - t0 < ms:
		var key := Vector2i.ZERO
		var found := false
		for k in pending_chunks:
			if _is_near(k, home):
				key = k
				found = true
				break
		if not found:
			near_pending = 0
			break
		pending_chunks.erase(key)
		game.world_maker.make_chunk(key)
		if not gen.needed(key).is_empty():
			# Over a socket the chunk, or one beside it, has not come yet: next frame.
			pending_chunks.append(key)
			return false
		near_pending -= 1
		build_chunk(key)
	return near_pending == 0


func _player_chunk_pos() -> Vector2:
	return Vector2(game.player.position.x, game.player.position.z) / (CHUNK * CELL)


func _player_chunk() -> Vector2i:
	return Vector2i(_player_chunk_pos().floor())


## The chunk the chunks are built around: the player's, or the focus.
func _load_chunk() -> Vector2i:
	if not focus.is_finite():
		return _player_chunk()
	return Vector2i((Vector2(focus.x, focus.z) / (CHUNK * CELL)).floor())


## Builds the chunks around `at` (world units) instead of the player's, Vector3.INF
## for the player again (see focus).
func set_focus(at: Vector3) -> void:
	if at == focus:
		return
	focus = at
	load_home = Vector2i(-1000000, 0)


func _is_near(key: Vector2i, home: Vector2i) -> bool:
	return maxi(absi(key.x - home.x), absi(key.y - home.y)) <= NEAR_CHUNKS


## Lists the chunks within LOAD_RANGE of the player (or the focus) that have no
## meshes yet, and queues the ones beyond UNLOAD_RANGE to lose theirs.
func _list_pending() -> void:
	var home := _load_chunk()
	var reach := PAUSE_RANGE if paused else LOAD_RANGE
	if home == load_home and reach == load_reach:
		return
	load_home = home
	load_reach = reach
	pending_chunks.clear()
	for cz in range(home.y - reach, home.y + reach + 1):
		for cx in range(home.x - reach, home.x + reach + 1):
			var key := Vector2i(cx, cz)
			if (not chunk_nodes.has(key) or bare.has(key)) and not (has_target and key == job_key):
				pending_chunks.append(key)
	unload_queue.clear()
	if focus.is_finite():
		if not pending_chunks.is_empty():
			map_done = false
		return
	for key: Vector2i in chunk_nodes:
		if maxi(absi(key.x - home.x), absi(key.y - home.y)) > UNLOAD_RANGE:
			unload_queue.append(key)
	if not pending_chunks.is_empty():
		map_done = false


## The pending chunk to build next: the one nearest to the screen seen from the player
## and from where it is going (lead), so what is on the screen ahead comes first and
## what is behind and to the sides off the screen last; around the focus, the nearest.
func next_chunk() -> Vector2i:
	var at := _load_chunk()
	var best := 0
	var best_d := INF
	var half := _screen_half()
	var here := _at()
	for i in pending_chunks.size():
		var k := pending_chunks[i]
		var d: float
		if focus.is_finite():
			d = maxi(absi(k.x - at.x), absi(k.y - at.y))
		else:
			d = _screen_score(k, here, half) + _screen_score(k, here + lead, half)
		if d < best_d:
			best_d = d
			best = i
	return pending_chunks.pop_at(best)


## The player's place on the ground plane (world units x, z).
func _at() -> Vector2:
	return Vector2(game.player.position.x, game.player.position.z)


## Half the width and the height of the world the camera shows, in world units (along
## PixelView.right and up).
func _screen_half() -> Vector2:
	var view = game.view
	if view == null or view.camera == null:
		return Vector2(32.0, 18.0)
	var size: float = view.camera.size
	return Vector2(size * view.image_size.x / maxf(1.0, view.image_size.y), size) * 0.5


## How far chunk `key` lies outside the screen seen from `from` (world units x, z), in
## screens: 0 or less where some of it is on the screen. The ground is taken as level
## with the player's (the shear of heights moves it a little up the image).
static func _screen_score(key: Vector2i, from: Vector2, half: Vector2) -> float:
	var d := (Vector2(key) + Vector2(0.5, 0.5)) * (CHUNK * CELL) - from
	# Half a chunk's diagonal: a chunk partly on the screen counts.
	var r := CHUNK * CELL * 0.71
	return maxf((absf(d.dot(PixelView.right)) - r) / half.x, (absf(d.dot(PixelView.up)) - r) / half.y)


## Follows the player's way (lead): its speed over the last frames, LOOK_AHEAD seconds
## of it; a jump of more than a chunk in a frame (a teleport, the respawn) starts over.
func _track_motion() -> void:
	if game.player == null:
		return
	var now := Time.get_ticks_msec()
	var at := _at()
	var dt := (now - _last_ms) / 1000.0
	if not _last_at.is_finite() or dt > 1.0 or at.distance_to(_last_at) > CHUNK * CELL:
		lead = Vector2.ZERO
	elif dt > 0.0:
		var want := ((at - _last_at) / dt * LOOK_AHEAD).limit_length(LEAD_MOST)
		lead = lead.lerp(want, 1.0 - exp(-dt * 4.0))
	_last_at = at
	_last_ms = now


## Whether a chunk on the screen has no ground yet (pending, or being built new).
func _check_lag() -> void:
	lagging = false
	if not game.ready_to_play or paused or focus.is_finite() or game.player == null:
		return
	var half := _screen_half()
	var here := _at()
	if (has_target or job_mesh != null) and not job_edit and not chunk_nodes.has(job_key) \
			and _screen_score(job_key, here, half) <= 0.0:
		lagging = true
		return
	if not stashed.is_empty() and not chunk_nodes.has(stashed[0]) \
			and _screen_score(stashed[0], here, half) <= 0.0:
		lagging = true
		return
	for k in pending_chunks:
		if not chunk_nodes.has(k) and _screen_score(k, here, half) <= 0.0:
			lagging = true
			return


# --- Building ----------------------------------------------------------------

## Has the session make what a chunk needs and builds its meshes and plants at once
## (the loading screen and tools).
func build_chunk(key: Vector2i) -> void:
	_whole = true
	game.world_maker.make_chunk(key)
	_whole = false
	var t0 := Time.get_ticks_usec()
	var jm := ChunkMesher.start(world, key.x * CHUNK, key.y * CHUNK, CHUNK)
	while not ChunkMesher.step(jm, 1 << 30):
		pass
	var meshes: Array = ChunkMesher.finish(jm)
	var jp := Foliage.start(world, key.x * CHUNK, key.y * CHUNK, CHUNK)
	while not Foliage.step(jp, 1 << 30):
		pass
	var plants: Dictionary = Foliage.finish(jp)
	mesh_us += Time.get_ticks_usec() - t0
	_note_work("meshes", Time.get_ticks_usec() - t0)
	dirty_chunks.erase(key)
	dirty_rects.erase(key)
	edited.erase(key)
	_keep(key, jm, jp)
	_apply_chunk(key, meshes, plants)


## Generates and builds every chunk within LOAD_RANGE of the player at once and
## frees the far ones (tools that move the player around): the server is told where
## the body is first, so the session makes and forgets around it.
func build_around() -> void:
	load_home = Vector2i(-1000000, 0)
	has_target = false
	stashed = []
	_drop_job()
	while not paint_queue.is_empty():
		_paint(paint_queue.pop_front())
	game.mirror.send_input()
	_list_pending()
	while not pending_chunks.is_empty():
		build_chunk(next_chunk())
	map_done = true
	while not unload_queue.is_empty():
		_unload_some()
	game.world_maker.forget_far(1 << 30)
	game.roof.flush()


## Adds `us` to the time spent on a kind of work (see work_us).
func _note_work(kind: String, us: int) -> void:
	work_us[kind] = work_us.get(kind, 0) + us


## The time spent on each kind of work since the last call (usec by kind, the
## session's kinds with "meshes"), and the count starts anew.
func take_work() -> Dictionary:
	var spent := work_us
	work_us = {}
	var made: Dictionary = game.world_maker.take_work()
	for kind: String in made:
		spent[kind] = spent.get(kind, 0) + made[kind]
	return spent


## The budgets for the session's generation next frame (Runner.near_us, far_us):
## loading or paused, the loading budget; playing, the edit budget for the chunks
## near the player and the stream budget for the rest, as for the meshes.
## While edits wait, the far chunks take a step a frame: the edits get the frame.
func gen_budgets() -> Vector2i:
	if not game.ready_to_play or paused:
		return Vector2i(load_budget, load_budget)
	var near := LAG_BUDGET_US if lagging else EDIT_BUDGET_US
	return Vector2i(near, 0 if not dirty_chunks.is_empty() else STREAM_BUDGET_US)


## A chunk reached a stage (WorldGen.made): once it is SHAPED its columns are final,
## so the roof map and the minimap take them, at once while a chunk is built whole
## (the loading screen and tools, see build_chunk), else one a frame (see run_jobs).
## The minimap paints its ground already at TERRAIN, two chunks ahead of the meshes,
## so the world is not seen being made at its edge; the trees come in with SHAPED. A
## chunk the map already shows (from the save, or made again after it was forgotten)
## is not painted bare at TERRAIN: its trees would go from the map until it is SHAPED
## again.
func _on_generated(key: Vector2i, stage: int) -> void:
	var parts: Array
	if stage == WorldGen.SHAPED:
		parts = [0, 1]
	elif stage == WorldGen.TERRAIN and not (game.hud != null and game.hud.minimap != null
			and game.hud.minimap.has_chunk(key)):
		parts = [1]
	for part: int in parts:
		if _whole:
			_paint(Vector3i(key.x, key.y, part))
		else:
			paint_queue.append(Vector3i(key.x, key.y, part))


## Paints chunk (item.x, item.y) into the roof map (item.z 0) or the minimap (1).
func _paint(item: Vector3i) -> void:
	var key := Vector2i(item.x, item.y)
	if not world.has_chunk(key):
		return
	if item.z == 0:
		game.roof.fill_chunk(world, key)
	elif game.hud != null and game.hud.minimap != null:
		game.hud.minimap.paint_chunk(world, key)


## Does part `job_part` of finishing the chunk being built (the meshes, the plants,
## then handing them to the renderer); true after the last. A chunk new on screen
## (job_ground) shows its ground and water after the meshes' parts, then builds its
## plants (job_part -2, see run_jobs) and finishes them.
func _finish_part() -> bool:
	var i := job_part
	var plants_from := ChunkMesher.FINISH_PARTS + (1 if job_ground else 0)
	if i < ChunkMesher.FINISH_PARTS:
		job_meshes.append(ChunkMesher.finish_part(job_mesh, i))
	elif job_ground and i == ChunkMesher.FINISH_PARTS:
		_chunk_nodes(job_key)
		_apply_ground(job_key, job_meshes)
		bare[job_key] = true
		job_part = -2
		return false
	elif i < plants_from + Foliage.FINISH_PARTS:
		Foliage.finish_part(job_plants, i - plants_from, job_plant_parts)
	else:
		_keep(job_key, job_mesh, job_plants)
		if job_ground:
			_apply_plants(job_key, job_plant_parts)
		else:
			_apply_chunk(job_key, job_meshes, job_plant_parts)
		bare.erase(job_key)
		_drop_job()
		if job_edit and not dirty_chunks.has(job_key):
			edited.erase(job_key)
		# Things fallen that waited for the ground to change on screen (a felled tree).
		game.props.drops_rebuilt()
		return true
	job_part += 1
	return false


## Forgets the mesh and plant jobs of the chunk being built.
func _drop_job() -> void:
	job_mesh = null
	job_plants = null
	job_old = []
	job_keep = false
	job_ground = false
	job_part = -1
	job_meshes = []
	job_plant_parts = {}


## Sets the chunk being streamed aside for the edits (see stashed).
func _stash_job() -> void:
	stashed = [job_key, job_mesh, job_plants, job_part, job_meshes, job_plant_parts, job_keep, job_budget, job_ground]
	has_target = false
	_drop_job()


## Takes the chunk set aside back up where it stopped.
func _unstash_job() -> void:
	job_key = stashed[0]
	job_mesh = stashed[1]
	job_plants = stashed[2]
	job_part = stashed[3]
	job_meshes = stashed[4]
	job_plant_parts = stashed[5]
	job_keep = stashed[6]
	job_budget = stashed[7]
	job_ground = stashed[8]
	job_edit = false
	has_target = not job_keep
	stashed = []


## Forgets the chunk set aside if it is `key` (its cells changed, or it went): a chunk
## being streamed is listed again, one built to keep its jobs is rebuilt for the edit.
func _unstash(key: Vector2i) -> void:
	if stashed.is_empty() or stashed[0] != key:
		return
	if not stashed[6]:
		pending_chunks.append(key)
	stashed = []


## Keeps the finished jobs of chunk `key` for patching if it is within KEEP_CHUNKS of the
## player, forgets them if not.
func _keep(key: Vector2i, jm: ChunkMesher.Job, jp: Foliage.Job) -> void:
	var home := _player_chunk() if game.player != null else kept_home
	if maxi(absi(key.x - home.x), absi(key.y - home.y)) > KEEP_CHUNKS:
		kept.erase(key)
		return
	ChunkMesher.keep(jm)
	kept[key] = [jm, jp]
	keep_queue.erase(key)


## Once the player is in another chunk: forgets the kept jobs of the chunks now far, and
## lists the chunks now near with none to build again when nothing else is to be built,
## the player's first.
func _keep_around() -> void:
	if game.player == null:
		return
	var home := _player_chunk()
	if home == kept_home:
		return
	kept_home = home
	forget_queue.clear()
	for key: Vector2i in kept.keys():
		if maxi(absi(key.x - home.x), absi(key.y - home.y)) > KEEP_CHUNKS:
			forget_queue.append(key)
	keep_queue.clear()
	for r in REFILL_CHUNKS + 1:
		for dz in range(-r, r + 1):
			for dx in range(-r, r + 1):
				var key := home + Vector2i(dx, dz)
				if maxi(absi(dx), absi(dz)) == r and chunk_nodes.has(key) and not kept.has(key):
					keep_queue.append(key)


## Builds chunks a step at a time within the frame's budget: edited chunks first (the
## chunk of the edit before its neighbours), then the chunks nearest to the player,
## each once the session has made it; `spent` is what the session's generation took
## this frame already (Runner.take_spent), which comes out of the budget. At least
## one step is taken a frame, so a job always ends. The pieces of work that cost more
## than a step (painting a shaped chunk into the roof map or the minimap, making a
## mesh or the plant buffers, handing them to the renderer) go one a frame, before
## anything else in it; an edit may do several while its budget lasts.
func run_jobs(spent := 0) -> void:
	var t0 := Time.get_ticks_usec() - spent
	budget_us += spent
	if not game.ready_to_play or paused:
		load_budget = clampi(t0 - _jobs_end, LOAD_BUDGET_US, LOAD_MAX_US) if _jobs_end > 0 else LOAD_BUDGET_US
		if not job_edit and (job_mesh != null or has_target):
			job_budget = load_budget
	_list_pending()
	_keep_around()
	_track_motion()
	_check_lag()
	if not dirty_chunks.is_empty() and game.ready_to_play and not paused:
		# Edits wait: the frame has their budget, whatever was built before (a far chunk
		# at the stream budget, which the making of the world could use up before a
		# single step of the edits, 2026-11-08).
		job_budget = EDIT_BUDGET_US
	var worked := false
	if not paint_queue.is_empty():
		var tp := Time.get_ticks_usec()
		_paint(paint_queue.pop_front())
		budget_us += Time.get_ticks_usec() - tp
		worked = true
	while true:
		var t1 := Time.get_ticks_usec()
		if t1 - t0 >= job_budget and worked:
			break
		if job_mesh != null and not job_edit and not dirty_chunks.is_empty() and stashed.is_empty() \
				and game.ready_to_play:
			# A chunk being streamed, or built to keep its jobs, waits for the edits.
			_stash_job()
		if job_mesh == null:
			var rect := Rect2i()
			if not dirty_chunks.is_empty():
				if has_target and not dirty_chunks.has(job_key):
					# A chunk being streamed whose job an edit dropped: back into the
					# queue, or it would never be built.
					pending_chunks.append(job_key)
				job_key = dirty_chunks.keys()[0]
				dirty_chunks.erase(job_key)
				rect = dirty_rects.get(job_key, Rect2i())
				dirty_rects.erase(job_key)
				job_edit = true
				job_budget = EDIT_BUDGET_US
				has_target = false
			elif not stashed.is_empty():
				# The chunk set aside for the edits, where it stopped.
				_unstash_job()
				continue
			elif (game.ready_to_play or load_steps) and (has_target or not pending_chunks.is_empty()):
				if not has_target:
					job_key = next_chunk()
					has_target = true
				job_edit = false
				var at := _load_chunk()
				var near := maxi(absi(job_key.x - at.x), absi(job_key.y - at.y)) <= URGENT_CHUNKS
				job_budget = EDIT_BUDGET_US if near else STREAM_BUDGET_US
				if lagging and _screen_score(job_key, _at(), _screen_half()) <= 0.0:
					job_budget = LAG_BUDGET_US
				if not game.ready_to_play or paused:
					job_budget = load_budget
				if not gen.needed(job_key).is_empty():
					# The session has not made it yet: back into the queue, nearest
					# first again next frame (the player may have walked on).
					pending_chunks.append(job_key)
					has_target = false
					break
			elif game.ready_to_play and not paused and not keep_queue.is_empty():
				# Nothing else to build: a chunk near the player built before it came,
				# again, to keep its jobs, at the stream budget.
				job_key = keep_queue.pop_front()
				if not chunk_nodes.has(job_key) or kept.has(job_key):
					continue
				job_edit = false
				job_keep = true
				job_budget = STREAM_BUDGET_US
			else:
				break
			var whole := Rect2i(job_key * CHUNK, Vector2i(CHUNK, CHUNK))
			if job_edit and kept.has(job_key) and rect.has_area() and rect != whole:
				# Only the columns around the change, put into the chunk's kept meshes
				# and plants once built (ChunkMesher.patch).
				job_old = kept[job_key]
				job_mesh = ChunkMesher.start_rect(world, rect.position.x, rect.position.y, rect.end.x, rect.end.y, true)
				job_plants = Foliage.start_part(world, job_key.x * CHUNK, job_key.y * CHUNK, CHUNK,
					Foliage.part_columns(world, job_key.x * CHUNK, job_key.y * CHUNK, CHUNK, rect))
			else:
				job_mesh = ChunkMesher.start(world, job_key.x * CHUNK, job_key.y * CHUNK, CHUNK)
				job_plants = Foliage.start(world, job_key.x * CHUNK, job_key.y * CHUNK, CHUNK)
				# Not on screen yet: the ground first, the plants after.
				job_ground = not job_edit and not job_keep and not chunk_nodes.has(job_key)
		var done := false
		if job_part < 0:
			while not done and (Time.get_ticks_usec() - t0 < job_budget or not worked):
				if job_part == -2:
					done = Foliage.step(job_plants, 1)
				elif job_ground:
					done = ChunkMesher.step(job_mesh, 1)
				else:
					done = ChunkMesher.step(job_mesh, 1) and Foliage.step(job_plants, 1)
				worked = true
				if done and not job_old.is_empty():
					# The columns around the change are built: into the kept meshes, then
					# (a step later, each costs a few columns) into the kept plants, then
					# the shadows of the chunk's trees again (Foliage.step).
					if job_old.size() == 2:
						job_mesh = ChunkMesher.patch(job_old[0], job_mesh)
						job_old = [job_old[1]]
					else:
						job_plants = Foliage.patch(job_old[0], job_plants)
						job_old = []
						patches += 1
					done = false
			budget_us += Time.get_ticks_usec() - t1
			_note_work("meshes", Time.get_ticks_usec() - t1)
			if not done:
				break
			job_part = ChunkMesher.FINISH_PARTS + 1 if job_part == -2 else 0
			continue
		# Loading behind the menu or the pause, the parts go on while the budget lasts.
		if worked and not job_edit and game.ready_to_play and not paused:
			break
		var finished := _finish_part()
		worked = true
		budget_us += Time.get_ticks_usec() - t1
		_note_work("meshes", Time.get_ticks_usec() - t1)
		if finished:
			has_target = false
			if not game.ready_to_play and not job_edit and _is_near(job_key, _player_chunk()):
				near_pending = maxi(0, near_pending - 1)
			if not job_edit:
				game.hud.perf.chunks = chunk_nodes.size()
			if not job_edit and pending_chunks.is_empty() and not map_done:
				map_done = true
				print("chunks around built in %d ms (generation %d ms, meshes %d ms)" % [Time.get_ticks_msec(), game.world_maker.gen_us / 1000, mesh_us / 1000])
	mesh_us += Time.get_ticks_usec() - t0 - spent
	_unload_some()
	_forget_some()
	_update_haze()
	_jobs_end = Time.get_ticks_usec()


## Turns the haze over the edge of what is built on or off («Дымка на краю»); it is
## made with the first frame of play.
func set_haze(on: bool) -> void:
	haze_on = on
	if not on and haze != null:
		haze.free_node()
		haze = null


## Lays the haze over the chunks on the screen with no ground yet.
func _update_haze() -> void:
	if not haze_on or game.player == null or not game.ready_to_play:
		return
	if haze == null:
		haze = EdgeHaze.new(game)
	var tp := Time.get_ticks_usec()
	haze.update(chunk_nodes, _at(), _screen_half(), game.player.position.y)
	budget_us += Time.get_ticks_usec() - tp


## Lets go of the kept jobs of a few chunks now far (see forget_queue).
func _forget_some() -> void:
	var n := 0
	while not forget_queue.is_empty() and n < FORGETS_PER_FRAME:
		var key: Vector2i = forget_queue.pop_back()
		if maxi(absi(key.x - kept_home.x), absi(key.y - kept_home.y)) > KEEP_CHUNKS and kept.has(key):
			kept.erase(key)
			n += 1


## Frees the meshes of chunk `key` now (the server told the client to forget it).
func unload_chunk(key: Vector2i) -> void:
	if (job_mesh != null or has_target) and job_key == key:
		_drop_job()
		has_target = false
	_unstash(key)
	pending_chunks.erase(key)
	dirty_chunks.erase(key)
	dirty_rects.erase(key)
	edited.erase(key)
	kept.erase(key)
	if not chunk_nodes.has(key):
		return
	_free_chunk(key)
	game.hud.perf.chunks = chunk_nodes.size()


## Frees the meshes of a couple of far chunks a frame.
func _unload_some() -> void:
	var n := 0
	while not unload_queue.is_empty() and n < UNLOADS_PER_FRAME:
		var key: Vector2i = unload_queue.pop_front()
		if not chunk_nodes.has(key):
			continue
		var at := _player_chunk()
		if maxi(absi(key.x - at.x), absi(key.y - at.y)) <= LOAD_RANGE:
			continue
		_free_chunk(key)
		n += 1
	if n > 0:
		game.hud.perf.chunks = chunk_nodes.size()


## Frees the nodes of shown chunk `key`: its meshes, its drops and its cap.
func _free_chunk(key: Vector2i) -> void:
	if (job_mesh != null or has_target) and job_key == key and not job_edit:
		# Its ground shown, its plants still being built (job_ground).
		_drop_job()
		has_target = false
	for node: Node in chunk_nodes[key]:
		node.queue_free()
	chunk_nodes.erase(key)
	bare.erase(key)
	_unstash(key)
	game.props.hide_drops(key)
	dirty_chunks.erase(key)
	dirty_rects.erase(key)
	edited.erase(key)
	kept.erase(key)
	if cap_nodes.has(key):
		cap_nodes[key].queue_free()
		cap_nodes.erase(key)
		cap_levels.erase(key)
	cap_cache.erase(key)
	_caps_ready = -1


func _apply_chunk(key: Vector2i, meshes: Array, plants: Dictionary) -> void:
	_chunk_nodes(key)
	_apply_ground(key, meshes)
	_apply_plants(key, plants)


## Makes the nodes of chunk `key` if it has none yet.
func _chunk_nodes(key: Vector2i) -> void:
	if not chunk_nodes.has(key):
		var solid := MeshInstance3D.new()
		solid.material_override = game.world_mat
		# A fire's real shadow falls on the ground and the walls alone (PixelView.LAYER_GROUND).
		solid.layers = PixelView.LAYER_GROUND
		var water := MeshInstance3D.new()
		water.material_override = game.water_mat
		water.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var tufts := Foliage.multimesh(game.grass_mesh, game.grass_mat, false, true)
		tufts.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		# The player's shadow from a fire lies over the grass too.
		tufts.layers = PixelView.LAYER_GROUND
		var crowns := Foliage.multimesh(game.clump_mesh, game.leaves_mat, true, true)
		crowns.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var shade := Foliage.multimesh(game.disc_mesh, game.leaf_shadow_mat, false, true)
		shade.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_SHADOWS_ONLY
		shade.layers = PixelView.LAYER_SUN_CASTER
		var bushes := Foliage.multimesh(game.bush_mesh, game.bush_mat, true, true)
		bushes.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		var drifts := Foliage.multimesh(game.drift_mesh, game.low_mat, false, false)
		var parts: Array = [solid, water, tufts, crowns, shade, bushes, drifts]
		for n in parts:
			if n == drifts:
				game.drifts_root.add_child(n)
			else:
				game.world_root.add_child(n)
		chunk_nodes[key] = parts
		# What lies on the ground of a chunk from the save.
		if world.drops.has(key) and not game.props.drop_nodes.has(key):
			game.props.show_drops(key)


## Shows the ground and the water of chunk `key`.
func _apply_ground(key: Vector2i, meshes: Array) -> void:
	cap_levels.erase(key)
	cap_cache.erase(key)
	_caps_ready = -1
	var nodes: Array = chunk_nodes[key]
	game.hud.perf.mark("сетка")
	nodes[0].mesh = meshes[0]
	nodes[1].mesh = meshes[1]
	_fit_box(nodes[0])
	_fit_box(nodes[1])


## Shows the plants of chunk `key` (grass, crowns, their shadows, bushes, drifts).
func _apply_plants(key: Vector2i, plants: Dictionary) -> void:
	var nodes: Array = chunk_nodes[key]
	for i in range(2, PARTS.size()):
		var part: Array = plants[PARTS[i]]
		var mm: MultiMesh = nodes[i].multimesh
		mm.instance_count = part[0]
		if part[0] > 0:
			mm.buffer = part[1]
	for i in range(2, nodes.size()):
		_fit_box(nodes[i])


## Fits the culling boxes of every chunk shown to the views the camera may show next
## (PixelView.box_views), when it turns or tilts.
func refit_boxes() -> void:
	for parts: Array in chunk_nodes.values():
		for n: GeometryInstance3D in parts:
			_fit_box(n)
	for n: GeometryInstance3D in cap_nodes.values():
		_fit_box(n)
	game.props.refit_boxes()


## Culls a part of a chunk by what it draws, moved north as the shaders draw it, instead
## of a margin of a level's height all round, which kept nearly every chunk loaded drawn
## (636 draw calls against 301 at the spawn by day, 2026-10-21).
static func _fit_box(n: GeometryInstance3D) -> void:
	var box := AABB()
	if n is MeshInstance3D:
		if n.mesh == null:
			return
		box = n.mesh.get_aabb()
	else:
		var mm: MultiMesh = n.multimesh
		if mm.instance_count == 0:
			return
		box = mm.get_aabb()
	n.custom_aabb = PixelView.sheared_box(box, SWAY)


## Queues the chunks a changed cell touches for a rebuild, the chunk of the cell
## first, and tells the roof map and the props.
func on_cell_changed(cell: Vector3i) -> void:
	game.roof.touch(world, cell)
	solid.touch(world, cell)
	# The ground around the player may have risen or gone: look again.
	hidden_at.y = -1000
	if game.hud != null and game.hud.minimap != null:
		game.hud.minimap.touch(world, cell)
	# Slopes and corners look at the neighbours, edges of a top at theirs, and the
	# surface of a slope at the slopes beside it (three columns in all). The chunk of
	# the cell goes first in the queue, then the chunks of the earlier changes not
	# rebuilt yet (the other columns of a felled tree), the neighbours after (see
	# run_jobs): a tree near a chunk's corner goes as soon as its own chunks are drawn,
	# not after the three around too.
	# A cell up in the air (a crown's) changes only the columns beside it
	# (ChunkMesher.reach).
	var home := WorldData.chunk_key(cell.x, cell.z)
	var r := ChunkMesher.reach(world, cell)
	var keys := {}
	for dz in range(-r, r + 1):
		for dx in range(-r, r + 1):
			keys[WorldData.chunk_key(cell.x + dx, cell.z + dz)] = true
	# Within each chunk only those columns are built again (see run_jobs), if it was kept.
	var around := Rect2i(cell.x - r, cell.z - r, 2 * r + 1, 2 * r + 1)
	for key: Vector2i in keys:
		if chunk_nodes.has(key):
			var part := around.intersection(Rect2i(key * CHUNK, Vector2i(CHUNK, CHUNK)))
			dirty_rects[key] = dirty_rects[key].merge(part) if dirty_rects.has(key) else part
	if job_mesh != null and keys.has(job_key):
		if job_edit:
			# The chunk being rebuilt for an edit changed again: the job goes on and
			# shows the earlier edit, and the chunk is rebuilt once more after it. Were
			# it started over, digging faster than a rebuild takes (a phone) would
			# never show the ground changing.
			keys[job_key] = true
		else:
			# A chunk being streamed: start it over as an edit (one built only to keep
			# its jobs is built whole for the edit).
			if not job_keep:
				has_target = true
			_drop_job()
	if not stashed.is_empty() and keys.has(stashed[0]):
		_unstash(stashed[0])
	var queue := {}
	if chunk_nodes.has(home):
		queue[home] = true
		edited[home] = true
	for key in dirty_chunks:
		if edited.has(key):
			queue[key] = true
	for key in keys:
		if chunk_nodes.has(key):
			queue[key] = true
	for key in dirty_chunks:
		queue[key] = true
	dirty_chunks = queue
	game.props.on_cell_changed(cell)


## Builds the mesh of chunk `key` again, by itself: what is drawn on it changed (the
## berries of a bush) but no cell did.
func remesh_chunk(key: Vector2i) -> void:
	if not chunk_nodes.has(key):
		return
	if job_mesh != null and job_key == key and not job_edit:
		if not job_keep:
			has_target = true
		_drop_job()
	_unstash(key)
	dirty_chunks[key] = true
	dirty_rects[key] = Rect2i(key * CHUNK, Vector2i(CHUNK, CHUNK))


# --- Level cutaway -----------------------------------------------------------

func update_cut(_delta: float) -> void:
	var player = game.player
	if world == null or player == null:
		return
	if player.body.on_ground:
		ground_level = player.level()
	else:
		# A jump does not move the cut, but a climb by jumps in the air (a playtest
		# switch) takes it along a level behind the feet, so the view leaves a cave
		# with the player instead of on landing; a fall takes it down with the feet.
		ground_level = clampi(ground_level, player.level() - 1, player.level())
	# The player stands on `level` and is two cells tall.
	var level := ground_level
	var px := floori(player.position.x / CELL)
	var pz := floori(player.position.z / CELL)
	indoor = false
	# Any roof over the head, however high (the vault of a tall cave).
	for y in range(level + 2, world.size_y):
		if Mat.is_roof(world.get_cell(px, y, pz)):
			indoor = true
			break
	var at := Vector3i(px, level, pz)
	solid.flush()
	if at != hidden_at:
		hidden_at = at
		hidden_by = _hiding_level(px, level, pz)
		hill = hidden_by >= 0 and not _hide_steep and not _rises_behind(px, level, pz)
	elif _hidden_view != Vector3(PixelView.up.x, PixelView.up.y, PixelView.slope):
		hidden_by = _hiding_level(px, level, pz)
		hill = hidden_by >= 0 and not _hide_steep and not _rises_behind(px, level, pz)
	var target: int = world.size_y
	if manual_level >= 0:
		# Walking away from the levels looked at brings the view back within reach.
		var reach := view_range()
		if manual_level > reach.y:
			manual_level = -1
		else:
			manual_level = maxi(manual_level, reach.x)
	if manual_level >= 0:
		target = manual_level
	elif indoor:
		# Over the head.
		target = level + 1
	elif hidden_by >= 0 and not hill:
		# Earth between the camera and the player goes where the player stands in a
		# dip (a ravine running across the view, the near wall of a diagonal one, a
		# pit) or behind a sheer wall (a block, a hut, a ledge). A hill or a mountain
		# the player climbs from the far side, its slope coming down to their feet,
		# stays whole (the player shows through it). Walls round the player that hide
		# nothing (a ravine running along the view) open nothing either.
		target = hidden_by - 1
	_update_depth()
	var opened := manual_level < 0 and target < world.size_y
	# Where the automatic cut would cut the view, the layers open it instead and fill
	# what they leave out with the rock's section, by the solid cells round the player.
	_update_layers(opened, at)
	if layers_on:
		solid.update(world, px, level, pz)
		target = world.size_y
	cut_target = target
	if target == cut_level:
		return
	# No delay, chosen or automatic: the view follows each change of level and the
	# player stepping out from under a roof at once (the user's pick, 2026-11-04).
	cut_level = target
	_apply_cut()


## The lowest level of earth (not trunks or leaves) that covers most of the body of a
## player standing on `level` in column (x, z), as the camera sees it, or -1. In the
## default 3/4 view a cell (x, y, z) covers the screen rows z - y - 1 .. z - y + 1 (its
## top and its south face) and the body, two cells tall, the rows pz - level - 1.5 ..
## pz - level + 0.5; earth above the head counts where it covers more than half of
## them. A wall the head looks over hides only the legs and is left alone. A turned or
## tilted view looks along its own way: a cell y - level up is drawn over the body
## from (y - level) * slope cells toward the camera.
func _hiding_level(x: int, level: int, z: int) -> int:
	var up := PixelView.up
	_hidden_view = Vector3(up.x, up.y, PixelView.slope)
	var body := Vector2(x + 0.5, z + 0.5)
	for y in range(level + 2, mini(level + 2 + HIDE_REACH, world.size_y)):
		var ahead := body - up * PixelView.slope * (y - level)
		for c: Vector2 in [ahead + up, ahead]:
			if Mat.is_roof(world.get_cell(floori(c.x), y, floori(c.y))):
				_hide_steep = _sheer_below(c + up, y)
				return y
	return -1


## Whether the two cells under level `y` in the column at `c` are open: the earth
## found over them stands as a sheer wall to the player's side (a hill of the test
## world, a hut, a ledge), not as a slope coming down to the player's feet.
func _sheer_below(c: Vector2, y: int) -> bool:
	for k in [1, 2]:
		if y - k < 0 or Mat.is_roof(world.get_cell(floori(c.x), y - k, floori(c.y))):
			return false
	return true


## Whether earth rises over the head of a player standing on `level` in column (x, z)
## within RISE_REACH cells behind them, away from the camera: the far side of a dip.
## Where none does, what hides the player is a hill they stand behind.
func _rises_behind(x: int, level: int, z: int) -> bool:
	var up := PixelView.up
	var body := Vector2(x + 0.5, z + 0.5)
	var y := level + 2
	if y >= world.size_y:
		return false
	for r in range(1, RISE_REACH + 1):
		var c := body + up * r
		if Mat.is_roof(world.get_cell(floori(c.x), y, floori(c.y))):
			return true
	return false


func shift_cut(d: int) -> void:
	if world == null:
		return
	var reach := view_range()
	# The view stays at the ends of the reach (the level button goes back to the
	# automatic cut); a cut over the whole world is none.
	manual_level = clampi(cut_base() + d, reach.x, reach.y)
	if manual_level >= world.size_y - 1:
		manual_level = -1


## The level the buttons step from: the level chosen, the cut, or above the player
## with none.
func cut_base() -> int:
	if manual_level >= 0:
		return manual_level
	return cut_level if cut_level < world.size_y else game.player.level() + 1


## The lowest and highest levels the level buttons may cut the view at: VIEW_REACH
## around the player's, and from below the surface of the column up to it, so a
## player fallen into a pit can look up out of it. The playtest switch lifts it.
func view_range() -> Vector2i:
	if game.settings.free_view:
		return Vector2i(1, world.size_y)
	var level: int = game.player.level()
	# Looked up again on a step to another column or level (a dug pit changes it).
	var at := Vector3i(floori(game.player.position.x / CELL), level, floori(game.player.position.z / CELL))
	if at != _surface_at:
		_surface_at = at
		_surface = 0
		for y in range(world.size_y - 1, 0, -1):
			if Mat.is_roof(world.get_cell(at.x, y, at.z)):
				_surface = y
				break
	return Vector2i(maxi(1, level - VIEW_REACH), maxi(level + VIEW_REACH, _surface + 1))


## Back to the automatic cut that follows the player.
func reset_view_level() -> void:
	manual_level = -1


func _apply_cut() -> void:
	var h := 1000.0 if cut_level >= world.size_y else (cut_level + 1) * CELL
	RenderingServer.global_shader_parameter_set("cut_height", h)
	# The caps follow in update_caps, nearest chunk first; with no cut they go at once.
	if cut_level >= world.size_y - 1:
		for key in cap_levels:
			cap_nodes[key].visible = false
		cap_levels.clear()
		_caps_ready = -1


## How much darker each level under the sea's surface gets (depth_steps.x, the test
## setting, see sea_bright).
func _update_depth() -> void:
	var steps := Vector4(game.settings.cut_depth(), 0.0, 0.0, 0.0)
	if steps != _depth_steps:
		_depth_steps = steps
		RenderingServer.global_shader_parameter_set("depth_steps", steps)


## Turns the view in layers on or off, from the player's feet in cell `at`.
func _update_layers(on: bool, at: Vector3i) -> void:
	if on == layers_on and (not on or at == layer_base):
		return
	layers_on = on
	layer_base = at
	RenderingServer.global_shader_parameter_set("layer_view",
		Vector4(1.0 if on else 0.0, at.x, at.y, at.z))


## The level the caps of the cut lie on, -1 for none.
func cap_level() -> int:
	if cut_level >= world.size_y - 1:
		return -1
	return cut_level


## Shows `mesh`, the cap of chunk `key` at `level`.
func _show_cap(key: Vector2i, level: int, mesh: Mesh) -> void:
	var node: MeshInstance3D = cap_nodes[key]
	node.mesh = mesh
	node.visible = true
	_fit_box(node)
	cap_levels[key] = level


## Brings the caps of the chunks around the player to the current cut, nearest first,
## a few a frame. The cap of a chunk is rebuilt when the cut moves or the chunk is
## edited (its entry in cap_levels goes); chunks out of range lose theirs.
func update_caps() -> void:
	if not game.ready_to_play:
		return
	var home := _player_chunk()
	if home != cap_home:
		cap_home = home
		_caps_ready = -1
		cap_order.clear()
		for cz in range(home.y - CAP_RANGE, home.y + CAP_RANGE + 1):
			for cx in range(home.x - CAP_RANGE, home.x + CAP_RANGE + 1):
				cap_order.append(Vector2i(cx, cz))
		var nearer := func(a: Vector2i, b: Vector2i) -> bool:
			return maxi(absi(a.x - home.x), absi(a.y - home.y)) < maxi(absi(b.x - home.x), absi(b.y - home.y))
		cap_order.sort_custom(nearer)
		for key in cap_levels.keys():
			if maxi(absi(key.x - home.x), absi(key.y - home.y)) > CAP_RANGE:
				cap_nodes[key].mesh = null
				cap_levels.erase(key)
		for key in cap_cache.keys():
			if maxi(absi(key.x - home.x), absi(key.y - home.y)) > CAP_RANGE:
				cap_cache.erase(key)
	var want: int = cap_level()
	if want < 0 or want == _caps_ready:
		return
	var t0 := Time.get_ticks_usec()
	var all_built := true
	# The caps already built for this level show at once, all of them.
	for key in cap_order:
		if cap_levels.get(key, -1) != want and cap_cache.has(key) and cap_cache[key].has(want) \
				and chunk_nodes.has(key) and cap_nodes.has(key):
			_show_cap(key, want, cap_cache[key][want])
	for key in cap_order:
		if cap_levels.get(key, -1) == want or not chunk_nodes.has(key):
			continue
		if not cap_nodes.has(key):
			var node := MeshInstance3D.new()
			node.material_override = game.world_mat
			# The rock the cap closes casts its own shadow: a cap's, a hair off it,
			# fell on the player jumping by the cut.
			node.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
			node.layers = PixelView.LAYER_GROUND
			game.world_root.add_child(node)
			cap_nodes[key] = node
		game.hud.perf.mark("срез")
		var mesh: Mesh = ChunkMesher.build_cap(world, want, key.x * CHUNK, key.y * CHUNK, CHUNK)
		var kept: Dictionary = cap_cache.get(key, {})
		if kept.size() >= CAP_KEPT:
			kept.erase(kept.keys()[0])
		kept[want] = mesh
		cap_cache[key] = kept
		_show_cap(key, want, mesh)
		if Time.get_ticks_usec() - t0 > CAP_BUDGET_US:
			all_built = false
			break
	if all_built:
		_caps_ready = want
	budget_us += Time.get_ticks_usec() - t0
