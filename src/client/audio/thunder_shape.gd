## The shape of thunder variant `v` (0-based): {"span" s, "env" its envelope}.
static func of(v: int) -> Dictionary:
	var env: Array = ENVELOPES[v % ENVELOPES.size()]
	return {"span": env.size() * STEP, "env": env}


## How loud thunder `s` (see of) is at `t` seconds (0..1).
static func gain(s: Dictionary, t: float) -> float:
	var env: Array = s.env
	var x := t / STEP
	var i := floori(x)
	if i < 0 or i >= env.size():
		return 0.0
	return lerpf(env[i], env[mini(i + 1, env.size() - 1)], x - i)
